# Wallet Connect Project ID (get from https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Contract Addresses (auto-populated by deployment script)
NEXT_PUBLIC_GAME_CONTRACT_ADDRESS=
NEXT_PUBLIC_ACHIEVEMENTS_CONTRACT_ADDRESS=

# Network Configuration
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_ENABLE_TESTNETS=true

# API Endpoints
NEXT_PUBLIC_ALCHEMY_API_KEY=your_alchemy_api_key
NEXT_PUBLIC_GRAPH_API_URL=https://api.studio.thegraph.com/query/your-subgraph

# Feature Flags
NEXT_PUBLIC_ENABLE_DEMO_MODE=true
NEXT_PUBLIC_ENABLE_SOUND=true
NEXT_PUBLIC_ENABLE_TOURNAMENTS=true
